# Copy to .env for `make run`. Every setting with its default; see config/config.go.
ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://directory:directory@localhost:5432/directory?sslmode=disable
# AUTO_MIGRATE=true
# HTTP_ADDR=:8080
# INTERNAL_ADDR=:8081            # /metrics, /healthz, /readyz — never publish
DIRECTORY_PUBLIC_URL=http://localhost:8080
# TRUSTED_PROXIES=10.0.0.0/8
# CORS_ALLOWED_ORIGINS=          # origins allowed credentialed (cookie) calls; GETs are CORS * anyway

# Directory identity (/.well-known/boson-directory.json)
DIRECTORY_NAME=boson directory
# DIRECTORY_OPERATOR=
# DIRECTORY_CONTACT=
# Shared secret for the stack admin panel (X-Internal-Token → operator). Empty = off.
# DIRECTORY_INTERNAL_TOKEN=

# Account sign-in through the boson auth service. Empty AUTH_ISSUER = Network keys only.
# AUTH_ISSUER=https://auth.boson.chat
# AUTH_JWKS_URL=                 # default: $AUTH_ISSUER/.well-known/jwks.json
# AUTH_AUDIENCE=boson
# AUTH_PUBLIC_URL=               # browser-facing auth URL for the web UI; default AUTH_ISSUER
# AUTH_ACCESS_COOKIE=boson_at

# DNS verification. DNS_VERIFIER=fake makes every check succeed (refused with ENV=production).
# DNS_VERIFIER=real
# DNS_RESOLVERS=cloudflare=1.1.1.1:53,google=8.8.8.8:53,quad9=9.9.9.9:53
# DNS_RESOLVER_TIMEOUT=5s
# VERIFY_TOKEN_TTL=72h           # first verification window
# VERIFY_LAPSE_AFTER=336h        # 14 days without a successful check → lapsed
# VERIFY_VERIFIED_EVERY=24h
# VERIFY_PENDING_EVERY=1h
# VERIFY_LAPSED_EVERY=168h
# VERIFY_WORKER_TICK=5m
# VERIFY_RATE_LIMIT=30s          # owner-triggered checks per network
# VERIFY_WORKER_ENABLED=true

# Health probes (TLS/TCP dial; LUSERS for user_count)
# HEALTH_WORKER_ENABLED=true
# HEALTH_EVERY=15m
# HEALTH_DIAL_TIMEOUT=5s
# HEALTH_USER_COUNT=true
# HEALTH_USER_COUNT_EVERY=1h
# HEALTH_CONCURRENCY=8

# Media (icons/banners): local dir served at /media/, or S3/R2.
MEDIA_DIR=./data/media
# MEDIA_PUBLIC_URL=              # default $DIRECTORY_PUBLIC_URL/media; required with S3
# MEDIA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=auto
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=

# Owner write rate limit per client IP
# RATE_LIMIT_WRITES_PER_MINUTE=30
# RATE_LIMIT_WRITE_BURST=10

# Federation (internal/services/federation)
# DIRECTORY_MAIN_PEER=https://directory.boson.chat
# DIRECTORY_INCLUDE_MAIN=true
# DIRECTORY_PEERS=
# DIRECTORY_SYNC_EVERY=10m

# OTLP metrics push (Prometheus /metrics is always on)
# OTEL_EXPORTER_OTLP_ENDPOINT=
